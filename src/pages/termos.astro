---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContratoDoc from '../components/ContratoDoc.astro';
import { STAGING, url } from '../lib/url';
---
<Base title="Contrato" description="Contrato de prestação de serviços de criação e renovação de site da FitDash." simples>
  <section class="tm-top">
    <div class="container">
      <p class="eyebrow">Contrato</p>
      <h1 class="h-lg">Tudo o que combinamos, por escrito.</h1>
      <p class="lead">Este é o contrato que você aceita no fim do pedido. Lá, ele vem preenchido com os seus dados, e você baixa a sua via em PDF.</p>
    </div>
  </section>
  <section class="section paper tm">
    <div class="container">
      {STAGING && <p class="tm__aviso">Minuta em revisão jurídica.</p>}
      <div class="tm__acoes">
        <button type="button" class="btn btn--outline btn--sm" data-imprimir><span><Icon name="upload" /> Salvar em PDF</span></button>
        <a class="btn btn--ink btn--sm" href={url('/comecar/')}><span>Começar meu site <Icon name="arrow" /></span></a>
      </div>
      <ContratoDoc id="contrato-modelo" />
    </div>
  </section>
</Base>

<script>
  import { imprimirVia } from '../scripts/via';
  document.querySelector('[data-imprimir]')?.addEventListener('click', () => imprimirVia(document.getElementById('contrato-modelo')!, 'Contrato FitDash (modelo)'));
</script>

<style>
  .tm-top {
    padding: calc(var(--header-h) + clamp(28px, 5vw, 64px)) 0 clamp(36px, 5vw, 64px);
    background: var(--c-bg);
  }
  .tm-top h1 {
    margin: 14px 0 16px;
    max-width: 18ch;
  }
  .tm {
    padding-top: clamp(32px, 4vw, 56px);
  }
  .tm__aviso {
    max-width: 820px;
    margin: 0 auto 16px;
    padding: 12px 16px;
    border-radius: 10px;
    background: #fff7ed;
    box-shadow: inset 0 0 0 1.5px #fed7aa;
    font-weight: 600;
  }
  .tm__acoes {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    max-width: 820px;
    margin: 0 auto 16px;
  }
  .tm__acoes :global(svg) {
    width: 16px;
  }
  .tm__acoes [data-imprimir] :global(svg) {
    transform: rotate(180deg);
  }
</style>
