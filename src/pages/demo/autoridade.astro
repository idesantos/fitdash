---
// Modelo Autoridade: o nome do personal em letras gigantes, atrás da foto recortada em arco.
import '@fontsource-variable/archivo/standard.css';
import { Image } from 'astro:assets';
import DemoPage from '../../components/demo/DemoPage.astro';
import demo from '../../data/demos/autoridade';
const h = demo.hero;
---
<DemoPage demo={demo} tema="autoridade">
  <section class="au-hero" slot="hero" data-au>
    <div class="au-nome au-nome--a" aria-hidden="true" data-au-a><span>RAFA LIMA · RAFA LIMA · RAFA LIMA ·</span></div>
    <div class="au-nome au-nome--b" aria-hidden="true" data-au-b><span>PERSONAL TRAINER · PERSONAL TRAINER ·</span></div>
    <div class="d-wrap au-in">
      <div class="au-foto"><Image src={h.foto!} alt="Rafa Lima, personal trainer" widths={[500, 800, 1100]} sizes="(min-width: 900px) 36vw, 80vw" loading="eager" /></div>
      <div class="au-txt">
        <p class="d-eyebrow">{h.eyebrow}</p>
        <h1 class="d-h1">{h.titulo}</h1>
        <p class="d-hero__txt">{h.texto}</p>
        <div class="d-hero__ctas">
          <button type="button" class="d-btn" data-demo-cta data-msg={demo.whatsMsg}>{demo.cta}</button>
          <a class="d-btn d-btn--ghost" href={h.ctaSec!.href}>{h.ctaSec!.label}</a>
        </div>
      </div>
    </div>
  </section>
</DemoPage>

<style is:global>
  .demo.demo--autoridade {
    --d-bg: #101216;
    --d-bg-2: #161920;
    --d-surface: #1a1d24;
    --d-fg: #ffffff;
    --d-muted: #a3a8b4;
    --d-line: rgb(255 255 255 / 10%);
    --d-accent: #f5b700;
    --d-accent-fg: #101216;
    --d-hdr-bg: rgb(16 18 22 / 90%);
    --d-hdr-fg: #fff;
    --d-display: 'Archivo Variable', system-ui, sans-serif;
    --d-dw: 900;
    --d-dstretch: 68%;
    --d-dtt: uppercase;
    --d-dls: 0;
    --d-dlh: 0.9;
    --d-r: 6px;
    --d-btn-r: 6px;
    --d-h1: clamp(64px, 9vw, 150px);
    --d-h2: clamp(44px, 6vw, 92px);
    --d-mod-cols: 4;
    --d-shadow: none;
    --d-card-border: inset 0 0 0 1px rgb(255 255 255 / 8%);
  }
  .demo--autoridade .d-btn {
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 15px;
  }
  .demo--autoridade .d-h3 {
    font-size: clamp(26px, 2.2vw, 34px);
  }
  .demo--autoridade .d-num strong {
    color: #fff;
  }
  .demo--autoridade .d-num div:nth-child(odd) strong {
    color: var(--d-accent);
  }
  .demo--autoridade .d-sobre__img {
    border-radius: 300px 300px var(--d-r) var(--d-r);
  }
  .demo--autoridade .d-pas__item {
    border-top: 3px solid var(--d-accent);
  }
  .demo--autoridade .d-pla__item.is-destaque {
    background: var(--d-accent);
    color: #101216;
  }
  .demo--autoridade .d-pla__item.is-destaque li::before {
    color: #101216;
  }
  .demo--autoridade .d-pla__item.is-destaque .d-btn {
    background: #101216;
    color: var(--d-accent);
  }
  .demo--autoridade .d-pla__item.is-destaque .d-pla__selo {
    background: #101216;
    color: var(--d-accent);
  }
  .demo--autoridade .d-loc__atende {
    margin-top: 12px;
    color: var(--d-accent);
    font-weight: 600;
  }
  .demo--autoridade .d-map {
    filter: invert(0.92) hue-rotate(180deg);
  }
  .demo--autoridade .d-map__pin {
    filter: invert(0.92) hue-rotate(180deg);
  }
  @media (max-width: 900px) {
    .demo.demo--autoridade {
      --d-mod-cols: 2;
    }
  }

  /* Hero */
  .au-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--d-ribbon-h) + var(--d-hdr-h) + 20px) 0 40px;
    overflow: hidden;
    isolation: isolate;
  }
  .au-nome {
    position: absolute;
    left: 0;
    z-index: -1;
    font-family: 'Archivo Variable', sans-serif;
    font-weight: 900;
    font-stretch: 62%;
    line-height: 0.8;
    white-space: nowrap;
    will-change: transform;
  }
  .au-nome--a {
    top: 16%;
    font-size: clamp(160px, 26vw, 420px);
    color: var(--d-accent);
  }
  .au-nome--b {
    bottom: 6%;
    font-size: clamp(90px, 13vw, 210px);
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(255 255 255 / 28%);
  }
  .au-in {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(28px, 4vw, 70px);
    align-items: center;
  }
  .au-foto {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 999px 999px 10px 10px;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 80%), 0 0 0 10px #101216;
  }
  .au-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }
  .au-txt .d-h1 {
    margin-top: 14px;
  }
  .au-txt .d-hero__txt {
    max-width: 40ch;
  }
  .au-txt {
    padding: 22px 26px;
    border-radius: 10px;
    background: rgb(16 18 22 / 72%);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  @media (max-width: 860px) {
    .au-in {
      grid-template-columns: 1fr;
    }
    .au-foto {
      width: min(320px, 80%);
      margin: 0 auto;
    }
  }
</style>

<script>
  import { gsap, reduced } from '../../scripts/demo/base';

  if (!reduced) {
    gsap.from('.au-foto', { clipPath: 'inset(100% 0 0 0)', duration: 1.5, ease: 'expo.inOut', delay: 0.15 });
    gsap.from('.au-txt > *', { x: 40, opacity: 0, duration: 1, ease: 'expo.out', stagger: 0.08, delay: 0.5 });
    // O nome desliza em sentidos opostos com a rolagem.
    const opts = () => ({ ease: 'none', scrollTrigger: { trigger: '[data-au]', start: 'top top', end: 'bottom top', scrub: 0.5 } });
    gsap.fromTo('[data-au-a]', { xPercent: 0 }, { xPercent: -28, ...opts() });
    gsap.fromTo('[data-au-b]', { xPercent: -30 }, { xPercent: 0, ...opts() });
  }
</script>
