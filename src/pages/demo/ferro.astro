---
// Modelo Ferro: a barra carrega as anilhas conforme a página desce.
import '@fontsource-variable/archivo/standard.css';
import { Image } from 'astro:assets';
import DemoPage from '../../components/demo/DemoPage.astro';
import demo from '../../data/demos/ferro';
const h = demo.hero;
// [x esquerda, largura, altura, cor, kg] de dentro para fora
const anilhas = [
  [296, 34, 200, '#ff3b1f', 25],
  [262, 34, 200, '#ff3b1f', 25],
  [234, 28, 200, '#2a2a30', 20],
  [212, 22, 150, '#e9e9ec', 10],
] as const;
---
<DemoPage demo={demo} tema="ferro">
  <section class="fe-hero" slot="hero" data-fe>
    <div class="fe-stage">
      <div class="fe-bg"><Image src={h.foto!} alt="" widths={[800, 1280, 1600]} sizes="100vw" loading="eager" /></div>
      <div class="d-wrap fe-in">
        <p class="d-eyebrow">{h.eyebrow}</p>
        <h1 class="d-h1 fe-title"><span>Treino pesado.</span><span>Resultado</span><span>de verdade.</span></h1>
        <div class="fe-bar">
          <svg viewBox="0 0 1200 220" aria-hidden="true">
            <defs>
              <linearGradient id="fe-aco" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#d9dbe0" /><stop offset=".5" stop-color="#8d9098" /><stop offset="1" stop-color="#55575e" /></linearGradient>
            </defs>
            <rect x="40" y="101" width="1120" height="18" rx="4" fill="url(#fe-aco)" />
            <rect x="120" y="94" width="210" height="32" rx="3" fill="url(#fe-aco)" />
            <rect x="870" y="94" width="210" height="32" rx="3" fill="url(#fe-aco)" />
            <rect x="330" y="84" width="14" height="52" rx="3" fill="#c9ccd2" />
            <rect x="856" y="84" width="14" height="52" rx="3" fill="#c9ccd2" />
            {anilhas.map(([x, w, a, cor], i) => (
              <g data-par={i}>
                <g data-lado="e"><rect x={x} y={110 - a / 2} width={w} height={a} rx="5" fill={cor} /><rect x={x + w / 2 - 2} y={110 - a / 2 + 14} width="4" height={a - 28} rx="2" fill="#000" opacity=".18" /></g>
                <g data-lado="d"><rect x={1200 - x - w} y={110 - a / 2} width={w} height={a} rx="5" fill={cor} /><rect x={1200 - x - w / 2 - 2} y={110 - a / 2 + 14} width="4" height={a - 28} rx="2" fill="#000" opacity=".18" /></g>
              </g>
            ))}
          </svg>
          <p class="fe-kg" aria-hidden="true"><strong data-fe-kg>20</strong><span>kg na barra</span></p>
        </div>
        <div class="fe-bottom">
          <p class="d-hero__txt">{h.texto}</p>
          <div class="d-hero__ctas">
            <button type="button" class="d-btn" data-demo-cta data-msg={demo.whatsMsg}>{demo.cta}</button>
            <a class="d-btn d-btn--ghost" href={h.ctaSec!.href}>{h.ctaSec!.label}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</DemoPage>

<style is:global>
  .demo.demo--ferro {
    --d-bg: #0e0e10;
    --d-bg-2: #141417;
    --d-surface: #18181c;
    --d-fg: #f2f2f2;
    --d-muted: #9c9ca6;
    --d-line: rgb(255 255 255 / 10%);
    --d-accent: #ff3b1f;
    --d-accent-fg: #fff;
    --d-hdr-bg: rgb(14 14 16 / 88%);
    --d-hdr-fg: #fff;
    --d-display: 'Archivo Variable', system-ui, sans-serif;
    --d-dw: 900;
    --d-dstretch: 66%;
    --d-dtt: uppercase;
    --d-dls: -0.005em;
    --d-dlh: 0.9;
    --d-r: 4px;
    --d-btn-r: 4px;
    --d-h1: clamp(52px, min(8.6vw, 12.5vh), 150px);
    --d-h2: clamp(44px, 6.4vw, 100px);
    --d-shadow: none;
    --d-card-border: inset 0 0 0 1px rgb(255 255 255 / 8%);
    --d-img-filter: grayscale(0.4) contrast(1.08);
  }
  .demo--ferro .d-btn {
    font-family: var(--d-display);
    font-stretch: 80%;
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .demo--ferro .d-h3 {
    font-size: clamp(26px, 2.2vw, 34px);
  }
  .demo--ferro .d-eyebrow {
    color: var(--d-accent);
  }
  .demo--ferro .d-num {
    border-block: 1px solid var(--d-line);
  }
  .demo--ferro .d-num strong {
    color: #fff;
  }
  .demo--ferro .d-mod__body {
    border-top: 3px solid var(--d-accent);
  }
  .demo--ferro .d-pla__item.is-destaque {
    background: var(--d-accent);
    color: #fff;
  }
  .demo--ferro .d-pla__item.is-destaque li::before {
    color: #fff;
  }
  .demo--ferro .d-pla__item.is-destaque .d-btn {
    background: #0e0e10;
  }
  .demo--ferro .d-pla__item.is-destaque .d-pla__selo {
    background: #0e0e10;
  }
  .demo--ferro .d-cta__box {
    background:
      repeating-linear-gradient(-45deg, rgb(0 0 0 / 12%) 0 14px, transparent 14px 28px),
      var(--d-accent);
  }
  .demo--ferro .d-map {
    filter: invert(0.92) hue-rotate(180deg);
  }
  .demo--ferro .d-map__pin {
    filter: invert(0.92) hue-rotate(180deg);
  }

  /* Hero com a barra */
  .fe-hero {
    position: relative;
    height: 230vh;
    color: #fff;
  }
  .fe-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  .fe-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .fe-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.6) brightness(0.42) contrast(1.1);
  }
  .fe-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 50% 62%, rgb(255 59 31 / 18%), transparent 70%),
      linear-gradient(180deg, rgb(14 14 16 / 55%), transparent 30%, transparent 60%, #0e0e10);
  }
  .fe-in {
    height: 100%;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    align-content: start;
    padding: calc(var(--d-ribbon-h) + var(--d-hdr-h) + clamp(12px, 3vh, 40px)) 0 clamp(28px, 5vh, 56px);
  }
  .fe-title {
    margin-top: 14px;
  }
  .fe-title span {
    display: block;
  }
  .fe-title span:nth-child(2) {
    color: var(--d-accent);
  }
  .fe-bar {
    position: relative;
    align-self: center;
    margin: clamp(8px, 2vh, 24px) 0;
  }
  .fe-bar svg {
    width: 100%;
    height: auto;
    max-height: 26vh;
    overflow: visible;
    filter: drop-shadow(0 18px 30px rgb(0 0 0 / 60%));
  }
  .fe-kg {
    position: absolute;
    right: 0;
    top: -6px;
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--d-display);
    font-stretch: 66%;
    text-transform: uppercase;
  }
  .fe-kg strong {
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 900;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .fe-kg span {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--d-muted);
  }
  .fe-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px 40px;
  }
  .fe-bottom .d-hero__txt {
    margin: 0;
    max-width: 44ch;
  }
  .fe-bottom .d-hero__ctas {
    margin: 0;
  }
  @media (max-width: 720px) {
    .fe-hero {
      height: 190vh;
    }
    .fe-kg {
      position: static;
      margin-top: 4px;
    }
    .fe-bar svg {
      max-height: none;
      transform: scale(1.4);
    }
    .fe-kg {
      margin-top: 18px;
    }
  }
</style>

<script>
  import { gsap, reduced } from '../../scripts/demo/base';

  const hero = document.querySelector<HTMLElement>('[data-fe]')!;
  const kg = hero.querySelector<HTMLElement>('[data-fe-kg]')!;
  const pares = [...hero.querySelectorAll<SVGGElement>('[data-par]')];
  const pesos = [25, 25, 20, 10];

  gsap.from('.fe-title span', { yPercent: 110, opacity: 0, duration: 1, ease: 'expo.out', stagger: 0.08, delay: 0.1 });

  if (reduced) {
    kg.textContent = '180';
  } else {
    // A barra começa vazia; cada par de anilhas entra numa faixa da rolagem.
    const tl = gsap.timeline({
      scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
      onUpdate: () => {
        let total = 20;
        pares.forEach((p, i) => {
          const prog = gsap.getProperty(p.querySelector('[data-lado="e"]'), 'opacity') as number;
          total += pesos[i] * 2 * Math.min(1, prog);
        });
        kg.textContent = String(Math.round(total));
      },
    });
    pares.forEach((p, i) => {
      tl.fromTo(p.querySelector('[data-lado="e"]'), { x: -760, opacity: 0 }, { x: 0, opacity: 1, duration: 1, ease: 'power3.in' }, i * 1.1);
      tl.fromTo(p.querySelector('[data-lado="d"]'), { x: 760, opacity: 0 }, { x: 0, opacity: 1, duration: 1, ease: 'power3.in' }, i * 1.1);
      tl.to(hero.querySelector('.fe-bar svg'), { y: 6, duration: 0.12, yoyo: true, repeat: 1, ease: 'power2.out' }, i * 1.1 + 1);
    });
    tl.to({}, { duration: 0.6 });
  }
</script>
