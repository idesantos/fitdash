---
// Modelo Família: bolhas e um peixinho mascote que acompanha a rolagem.
import '@fontsource-variable/nunito/wght.css';
import { Image } from 'astro:assets';
import DemoPage from '../../components/demo/DemoPage.astro';
import demo from '../../data/demos/familia';
const h = demo.hero;
const bolhas = Array.from({ length: 14 }, (_, i) => ({ x: (i * 53) % 100, s: 10 + ((i * 7) % 28), d: (i * 0.73) % 6, t: 6 + ((i * 3) % 6) }));
---
<DemoPage demo={demo} tema="familia">
  <section class="fa-hero" slot="hero">
    <div class="d-wrap fa-in">
      <div class="fa-txt">
        <p class="fa-tag">{h.eyebrow}</p>
        <h1 class="d-h1">Desde o <span class="fa-c1">primeiro</span> <span class="fa-c2">mergulho.</span></h1>
        <p class="d-hero__txt">{h.texto}</p>
        <div class="d-hero__ctas">
          <button type="button" class="d-btn" data-demo-cta data-msg={demo.whatsMsg}>{demo.cta}</button>
          <a class="d-btn d-btn--ghost" href={h.ctaSec!.href}>{h.ctaSec!.label}</a>
        </div>
        <ul class="d-selos">{h.selos!.map((s) => <li>{s}</li>)}</ul>
      </div>
      <div class="fa-visual">
        <div class="fa-blob"><Image src={h.foto!} alt="Criança nadando debaixo d'água" widths={[500, 800, 1100]} sizes="(min-width: 900px) 46vw, 88vw" loading="eager" /></div>
        <span class="fa-sticker">32 °C</span>
        <div class="fa-bolhas" aria-hidden="true">{bolhas.map((b) => <i style={`--x:${b.x}%;--s:${b.s}px;--d:${b.d}s;--t:${b.t}s`}></i>)}</div>
      </div>
    </div>
  </section>
  <div class="fa-peixe" slot="fim" aria-hidden="true" data-peixe>
    <svg viewBox="0 0 84 56">
      <path d="M62 28 82 12v32z" fill="#ff7b00" />
      <ellipse cx="36" cy="28" rx="30" ry="21" fill="#ff9f1c" />
      <path d="M30 8c6-6 16-6 20 2" fill="none" stroke="#ff7b00" stroke-width="6" stroke-linecap="round" />
      <path d="M30 33c4 6 12 6 16 0" fill="#ffb84d" />
      <circle cx="20" cy="22" r="6.5" fill="#fff" /><circle cx="18.5" cy="22" r="3.5" fill="#1d3557" />
      <path d="M10 33c3 2 6 2 8 0" fill="none" stroke="#1d3557" stroke-width="2.2" stroke-linecap="round" />
    </svg>
  </div>
</DemoPage>

<style is:global>
  .demo.demo--familia {
    --d-bg: #fff8e8;
    --d-bg-2: #e8f7fd;
    --d-surface: #ffffff;
    --d-fg: #1d3557;
    --d-muted: #5b6b84;
    --d-line: rgb(29 53 87 / 10%);
    --d-accent: #ff9f1c;
    --d-accent-fg: #1d3557;
    --d-hdr-bg: rgb(255 248 232 / 90%);
    --d-hdr-fg: #1d3557;
    --d-hero-fg: #1d3557;
    --d-font: 'Nunito Variable', system-ui, sans-serif;
    --d-display: 'Nunito Variable', system-ui, sans-serif;
    --d-dw: 900;
    --d-dls: -0.03em;
    --d-dlh: 1;
    --d-r: 28px;
    --d-h1: clamp(48px, 6.6vw, 104px);
    --d-mod-cols: 4;
    --d-shadow: 0 2px 0 rgb(29 53 87 / 8%), 0 18px 40px -26px rgb(29 53 87 / 35%);
  }
  .demo--familia .d-btn {
    font-weight: 800;
    font-size: 17px;
    box-shadow: 0 5px 0 #e07f00;
  }
  .demo--familia .d-btn:hover {
    transform: translateY(2px);
    box-shadow: 0 3px 0 #e07f00;
  }
  .demo--familia .d-btn--ghost {
    background: #fff;
    box-shadow: 0 5px 0 rgb(29 53 87 / 15%), inset 0 0 0 2px rgb(29 53 87 / 15%);
  }
  .demo--familia .d-eyebrow {
    color: #f72585;
  }
  .demo--familia .d-mod__tag {
    background: #4cc9f0;
    color: #06284a;
  }
  .demo--familia .d-mod__item:nth-child(2) .d-mod__tag {
    background: #80ed99;
  }
  .demo--familia .d-mod__item:nth-child(3) .d-mod__tag {
    background: #ffd166;
  }
  .demo--familia .d-mod__item:nth-child(4) .d-mod__tag {
    background: #f9a8d4;
  }
  .demo--familia .d-pas__item::before {
    content: '';
    width: 64px;
    height: 34px;
    border-radius: 34px 34px 8px 8px;
    background: var(--cor, #4cc9f0);
  }
  .demo--familia .d-pas__item:nth-child(1) { --cor: #ffd166; }
  .demo--familia .d-pas__item:nth-child(2) { --cor: #80ed99; }
  .demo--familia .d-pas__item:nth-child(3) { --cor: #4cc9f0; }
  .demo--familia .d-pas__item:nth-child(4) { --cor: #f72585; }
  .demo--familia .d-pla__item.is-destaque {
    background: #1d3557;
    color: #fff;
  }
  .demo--familia .d-cta__box {
    background: #4cc9f0;
    color: #06284a;
  }
  .demo--familia .d-cta__box .d-btn {
    background: #ff9f1c;
    color: #1d3557;
  }
  .demo--familia .d-div {
    display: block;
    height: 30px;
    background:
      radial-gradient(circle, #4cc9f0 6px, transparent 7px) 0 50% / 64px 30px repeat-x,
      radial-gradient(circle, #ffd166 4px, transparent 5px) 22px 30% / 64px 30px repeat-x,
      radial-gradient(circle, #f9a8d4 5px, transparent 6px) 44px 70% / 64px 30px repeat-x;
    opacity: 0.7;
  }
  .demo--familia .d-div i {
    display: none;
  }
  @media (max-width: 900px) {
    .demo.demo--familia {
      --d-mod-cols: 2;
    }
  }

  /* Hero */
  .fa-hero {
    padding: calc(var(--d-ribbon-h) + var(--d-hdr-h) + clamp(16px, 4vh, 48px)) 0 clamp(40px, 8vh, 90px);
    background:
      radial-gradient(40% 50% at 85% 30%, rgb(76 201 240 / 25%), transparent 70%),
      radial-gradient(30% 40% at 10% 90%, rgb(255 209 102 / 35%), transparent 70%);
    overflow: hidden;
  }
  .fa-in {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(28px, 5vw, 70px);
    align-items: center;
  }
  .fa-tag {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 4px 0 rgb(29 53 87 / 10%);
    font-weight: 800;
    color: #f72585;
  }
  .fa-txt .d-h1 {
    margin-top: 20px;
  }
  .fa-c1 {
    color: #4cc9f0;
  }
  .fa-c2 {
    color: #ff9f1c;
  }
  .fa-txt .d-hero__txt {
    color: var(--d-muted);
    opacity: 1;
  }
  .fa-visual {
    position: relative;
  }
  .fa-blob {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 58% 42% 46% 54% / 52% 44% 56% 48%;
    box-shadow: 0 30px 60px -30px rgb(29 53 87 / 50%);
    animation: fa-blob 12s ease-in-out infinite;
  }
  .fa-blob img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @keyframes fa-blob {
    0%, 100% { border-radius: 58% 42% 46% 54% / 52% 44% 56% 48%; }
    33% { border-radius: 44% 56% 58% 42% / 46% 58% 42% 54%; }
    66% { border-radius: 52% 48% 40% 60% / 60% 42% 58% 40%; }
  }
  .fa-sticker {
    position: absolute;
    left: -4%;
    bottom: 10%;
    display: grid;
    place-items: center;
    width: clamp(86px, 9vw, 120px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffd166;
    font-weight: 900;
    font-size: clamp(20px, 2vw, 28px);
    transform: rotate(-12deg);
    box-shadow: 0 6px 0 #e9b53f;
  }
  .fa-bolhas {
    position: absolute;
    inset: -10% -6% 0;
    pointer-events: none;
  }
  .fa-bolhas i {
    position: absolute;
    left: var(--x);
    bottom: 0;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #fff, rgb(255 255 255 / 30%) 40%, rgb(76 201 240 / 30%));
    box-shadow: inset 0 0 0 1.5px rgb(76 201 240 / 60%);
    opacity: 0;
    animation: fa-sobe var(--t) ease-in var(--d) infinite;
  }
  @keyframes fa-sobe {
    0% { transform: translate(0, 0); opacity: 0; }
    10% { opacity: 1; }
    50% { transform: translate(14px, -45vh); }
    100% { transform: translate(-8px, -90vh); opacity: 0; }
  }

  /* Peixinho */
  .fa-peixe {
    position: fixed;
    right: clamp(8px, 2vw, 28px);
    top: 0;
    z-index: 40;
    width: clamp(54px, 5vw, 76px);
    pointer-events: none;
    will-change: transform;
  }
  .fa-peixe svg {
    width: 100%;
    height: auto;
    animation: fa-nada 1.6s ease-in-out infinite;
  }
  @keyframes fa-nada {
    50% { transform: translateY(-4px) rotate(-4deg); }
  }
  .fa-bolha-p {
    position: fixed;
    z-index: 39;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px rgb(76 201 240 / 80%);
    background: rgb(255 255 255 / 60%);
    pointer-events: none;
  }
  @media (max-width: 860px) {
    .fa-in {
      grid-template-columns: 1fr;
    }
    .fa-visual {
      max-width: 440px;
      margin-inline: auto;
    }
  }
</style>

<script>
  import { gsap, reduced } from '../../scripts/demo/base';

  const peixe = document.querySelector<HTMLElement>('[data-peixe]');
  if (peixe && !reduced) {
    // O peixinho desce junto com a página e vira de lado conforme a direção.
    let alvo = 0;
    let atual = 0;
    let lado = 1;
    let angulo = 0;
    let ultimaBolha = 0;
    const topo = () => (document.querySelector('[data-ribbon]') as HTMLElement).offsetHeight + 90;
    gsap.ticker.add((t) => {
      const max = document.documentElement.scrollHeight - innerHeight;
      const p = max > 0 ? scrollY / max : 0;
      alvo = topo() + p * (innerHeight - topo() - 160);
      const antes = atual;
      atual += (alvo - atual) * 0.08;
      const andando = Math.abs(atual - antes) > 0.4;
      if (andando) lado = atual > antes ? 1 : -1;
      // Cabeça do desenho aponta para a esquerda: -70° desce, 70° sobe, 0° parado.
      angulo += ((andando ? lado * -70 : 0) - angulo) * 0.1;
      peixe.style.transform = `translateY(${atual.toFixed(1)}px) rotate(${angulo.toFixed(1)}deg)`;
      if (Math.abs(atual - antes) > 0.6 && t - ultimaBolha > 0.25) {
        ultimaBolha = t;
        const r = peixe.getBoundingClientRect();
        const b = document.createElement('i');
        b.className = 'fa-bolha-p';
        b.style.left = `${r.left + r.width / 2}px`;
        b.style.top = `${r.top + (lado > 0 ? 0 : r.height)}px`;
        document.body.append(b);
        gsap.to(b, { y: -60 - Math.random() * 40, x: (Math.random() - 0.5) * 30, opacity: 0, scale: 0.4 + Math.random(), duration: 1.4, ease: 'power1.out', onComplete: () => b.remove() });
      }
    });
    gsap.from('.fa-txt > *', { y: 30, opacity: 0, duration: 1, ease: 'back.out(1.6)', stagger: 0.08, delay: 0.1 });
    gsap.from('.fa-blob', { scale: 0.6, opacity: 0, duration: 1.4, ease: 'elastic.out(1, 0.6)', delay: 0.2 });
  }
</script>
