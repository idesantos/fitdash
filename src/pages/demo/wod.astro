---
// Modelo WOD: um cronômetro de box corre conforme a página desce, e o quadro escreve o treino do dia.
import '@fontsource-variable/jetbrains-mono/wght.css';
import { Image } from 'astro:assets';
import DemoPage from '../../components/demo/DemoPage.astro';
import demo from '../../data/demos/wod';
const h = demo.hero;
---
<DemoPage demo={demo} tema="wod">
  <section class="wo-hero" slot="hero">
    <div class="wo-bg"><Image src={h.foto!} alt="" widths={[800, 1280, 1600]} sizes="100vw" loading="eager" /></div>
    <div class="d-wrap wo-in">
      <div>
        <p class="d-eyebrow">{h.eyebrow}</p>
        <h1 class="d-h1">{h.titulo}</h1>
        <p class="d-hero__txt">{h.texto}</p>
        <div class="d-hero__ctas">
          <button type="button" class="d-btn" data-demo-cta data-msg={demo.whatsMsg}>{demo.cta}</button>
          <a class="d-btn d-btn--ghost" href={h.ctaSec!.href}>{h.ctaSec!.label}</a>
        </div>
      </div>
      <div class="wo-clock wo-clock--big" aria-hidden="true">
        <span class="wo-clock__lbl">AMRAP 20'</span>
        <span class="wo-clock__t" data-wo-t>00:00</span>
        <span class="wo-clock__r">Round <b data-wo-r>1</b></span>
      </div>
    </div>
  </section>
  <div class="wo-clock wo-clock--mini" slot="fim" aria-hidden="true" data-wo-mini>
    <span class="wo-clock__t" data-wo-t>00:00</span>
  </div>
</DemoPage>

<style is:global>
  .demo.demo--wod {
    --d-bg: #141414;
    --d-bg-2: #1a1a1a;
    --d-surface: #1f1f1f;
    --d-fg: #f4f4f4;
    --d-muted: #a8a8a8;
    --d-line: rgb(255 255 255 / 10%);
    --d-accent: #ffd400;
    --d-accent-fg: #141414;
    --d-hdr-bg: rgb(20 20 20 / 90%);
    --d-hdr-fg: #f4f4f4;
    --d-display: 'JetBrains Mono Variable', ui-monospace, monospace;
    --d-dw: 800;
    --d-dtt: uppercase;
    --d-dls: -0.04em;
    --d-dlh: 1;
    --d-r: 4px;
    --d-btn-r: 2px;
    --d-h1: clamp(38px, 5.4vw, 84px);
    --d-h2: clamp(30px, 4vw, 58px);
    --d-shadow: none;
    --d-card-border: inset 0 0 0 1px rgb(255 255 255 / 9%);
    --d-img-filter: grayscale(0.25) contrast(1.05);
  }
  .demo--wod .d-btn {
    font-family: var(--d-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  .demo--wod .d-mod__body {
    border-left: 4px solid var(--d-accent);
  }
  .demo--wod .d-hor td span {
    background: rgb(255 212 0 / 14%);
    font-family: var(--d-display);
    font-size: 13px;
  }
  .demo--wod .d-pla__item.is-destaque {
    background: var(--d-accent);
    color: #141414;
  }
  .demo--wod .d-pla__item.is-destaque li::before {
    color: #141414;
  }
  .demo--wod .d-pla__item.is-destaque .d-btn {
    background: #141414;
    color: var(--d-accent);
  }
  .demo--wod .d-cta__box {
    background: var(--d-accent);
  }
  .demo--wod .d-cta__box .d-btn {
    background: #141414;
    color: var(--d-accent);
  }
  .demo--wod .d-map {
    filter: invert(0.92) hue-rotate(180deg);
  }
  .demo--wod .d-map__pin {
    filter: invert(0.92) hue-rotate(180deg);
  }

  /* Hero */
  .wo-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--d-ribbon-h) + var(--d-hdr-h) + 30px) 0 60px;
    color: #f4f4f4;
    overflow: hidden;
    isolation: isolate;
  }
  .wo-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .wo-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.5) brightness(0.38);
  }
  .wo-in {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(28px, 4vw, 60px);
    align-items: center;
  }
  .wo-in .d-h1 {
    margin-top: 16px;
  }

  /* Cronômetro de box */
  .wo-clock {
    display: grid;
    justify-items: center;
    gap: 6px;
    padding: 18px 22px;
    border-radius: 10px;
    background: #050505;
    box-shadow: inset 0 0 0 2px #2a2a2a, 0 20px 50px -20px rgb(0 0 0 / 80%);
    font-family: 'JetBrains Mono Variable', monospace;
  }
  .wo-clock__t {
    font-size: clamp(64px, 9vw, 140px);
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #ff3b30;
    text-shadow: 0 0 12px rgb(255 59 48 / 70%), 0 0 30px rgb(255 59 48 / 35%);
  }
  .wo-clock__lbl,
  .wo-clock__r {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9a9a9a;
  }
  .wo-clock__r b {
    color: var(--d-accent);
  }
  .wo-clock--mini {
    position: fixed;
    right: 16px;
    top: calc(var(--d-hdr-h) + 12px);
    z-index: 45;
    padding: 8px 12px;
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.4s, transform 0.4s;
    pointer-events: none;
  }
  .wo-clock--mini .wo-clock__t {
    font-size: 26px;
  }
  .wo-clock--mini.is-on {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 860px) {
    .wo-in {
      grid-template-columns: 1fr;
    }
    .wo-clock--big {
      justify-self: start;
    }
    .wo-clock--mini {
      top: auto;
      bottom: 86px;
      right: 12px;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reduced } from '../../scripts/demo/base';

  // Cronômetro: a página inteira vale 20 minutos de AMRAP.
  const tempos = document.querySelectorAll<HTMLElement>('[data-wo-t]');
  const round = document.querySelector<HTMLElement>('[data-wo-r]');
  const mini = document.querySelector<HTMLElement>('[data-wo-mini]');
  const dois = (n: number) => String(n).padStart(2, '0');
  const atualizar = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? Math.min(1, scrollY / max) : 0;
    const s = Math.round(p * 1200);
    const txt = `${dois(Math.floor(s / 60))}:${dois(s % 60)}`;
    tempos.forEach((t) => (t.textContent = txt));
    if (round) round.textContent = String(1 + Math.floor(p * 7));
    mini?.classList.toggle('is-on', scrollY > innerHeight * 0.8);
  };
  gsap.ticker.add(atualizar);
  atualizar();

  // Quadro: o treino vai sendo escrito linha por linha.
  const linhas = [...document.querySelectorAll<HTMLElement>('[data-chalk]')];
  if (!reduced && linhas.length) {
    const textos = linhas.map((l) => l.textContent ?? '');
    linhas.forEach((l) => (l.textContent = ''));
    ScrollTrigger.create({
      trigger: '.d-wod__board',
      start: 'top 75%',
      once: true,
      onEnter: () => {
        let i = 0;
        const escrever = () => {
          if (i >= linhas.length) return;
          const alvo = textos[i];
          const el = linhas[i];
          let c = 0;
          const id = setInterval(() => {
            el.textContent = alvo.slice(0, ++c);
            if (c >= alvo.length) {
              clearInterval(id);
              i++;
              setTimeout(escrever, 90);
            }
          }, 22);
        };
        escrever();
      },
    });
  }
</script>
