---
import Icon from './Icon.astro';
import ModeloThumb from './ModeloThumb.astro';
import { categorias, modelosDa } from '../data/modelos';
import { url } from '../lib/url';
---
<div class="mg" data-tabs>
  <div class="mg__tabs" role="tablist" aria-label="Categorias">
    {categorias.map((c, i) => (
      <button type="button" role="tab" id={`tab-${c.id}`} aria-controls={`painel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="mg__tab">
        <span>{c.curto}</span>
      </button>
    ))}
  </div>

  {categorias.map((c, i) => (
    <div class="mg__panel" role="tabpanel" id={`painel-${c.id}`} aria-labelledby={`tab-${c.id}`} hidden={i !== 0}>
      <p class="mg__pages"><strong>{c.paginas.length} páginas:</strong> {c.paginas.join(' · ')}</p>
      <ul class="mg__grid grid-safe">
        {modelosDa(c.id).map((m) => (
          <li class="mcard">
            <a class="mcard__thumb" href={m.demo ?? url(`/comecar/?modelo=${m.slug}`)} target={m.demo ? '_blank' : undefined} rel={m.demo ? 'noopener' : undefined} tabindex="-1" aria-hidden="true">
              <ModeloThumb modelo={m} />
              {m.demo && <span class="mcard__live"><i></i> Ao vivo</span>}
            </a>
            <div class="mcard__body">
              <div class="mcard__top">
                <h3 class="mcard__nome">{m.nome}</h3>
                {m.demoReal && <span class="chip">Site real: {m.demoReal}</span>}
              </div>
              <p class="mcard__ideia">{m.ideia}</p>
              <p class="mcard__efeito"><Icon name="sparkle" /> {m.efeito}</p>
              <div class="mcard__acoes">
                <a class="btn btn--ink btn--sm" href={url(`/comecar/?modelo=${m.slug}`)} data-track="escolheu_modelo" data-track-label={m.slug}><span>Quero esse <Icon name="arrow" /></span></a>
                {m.demo ? (
                  <a class="mcard__demo" href={m.demo} target="_blank" rel="noopener" data-track="viu_demo" data-track-label={m.slug}>Ver ao vivo <Icon name="external" /></a>
                ) : (
                  <span class="mcard__soon">Demo em produção</span>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .mg__tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 4px 4px 10px;
    margin: 0 -4px;
    scrollbar-width: none;
  }
  .mg__tabs::-webkit-scrollbar {
    display: none;
  }
  .mg__tab {
    flex: none;
    min-height: 46px;
    padding: 0 22px;
    border: 0;
    border-radius: 8px;
    background: #fff;
    color: var(--c-ink);
    font: 800 15px/1 var(--f-display);
    font-stretch: 105%;
    cursor: pointer;
    transform: skewX(var(--slant));
    box-shadow: inset 0 0 0 1.5px var(--c-ink-line);
    transition:
      background 0.25s,
      color 0.25s,
      box-shadow 0.25s;
  }
  .mg__tab > span {
    display: inline-block;
    transform: skewX(12deg);
  }
  .mg__tab:hover {
    box-shadow: inset 0 0 0 1.5px var(--c-ink);
  }
  .mg__tab[aria-selected='true'] {
    background: var(--c-ink);
    color: #fff;
    box-shadow: none;
  }
  .mg__pages {
    margin: 18px 0 22px;
    font-size: 15px;
    color: var(--c-ink-muted);
  }
  .mg__pages strong {
    color: var(--c-ink);
  }
  .mg__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .mcard {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-md);
    background: #fff;
    box-shadow:
      0 1px 2px rgb(11 15 23 / 6%),
      0 16px 40px -24px rgb(11 15 23 / 30%);
    overflow: hidden;
    transition:
      transform 0.45s var(--ease-out),
      box-shadow 0.45s var(--ease-out);
  }
  .mcard:hover {
    transform: translateY(-4px);
    box-shadow:
      0 1px 2px rgb(11 15 23 / 6%),
      0 28px 60px -28px rgb(11 15 23 / 45%);
  }
  .mcard__thumb {
    position: relative;
    display: block;
    padding: 12px 12px 0;
    color: inherit;
    text-decoration: none;
  }
  .mcard__live {
    position: absolute;
    top: 22px;
    left: 22px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 6px;
    background: rgb(0 0 0 / 70%);
    color: #fff;
    font: 700 12px/1 var(--f-body);
  }
  .mcard__live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c-green);
    box-shadow: 0 0 0 0 rgb(17 244 178 / 60%);
    animation: pulso 1.8s infinite;
  }
  @keyframes pulso {
    70% {
      box-shadow: 0 0 0 8px rgb(17 244 178 / 0%);
    }
  }
  .mcard__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 10px;
    padding: 18px 20px 20px;
  }
  .mcard__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .mcard__nome {
    font-size: 26px;
  }
  .mcard__ideia {
    color: var(--c-ink);
    font-size: 16px;
  }
  .mcard__efeito {
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: var(--c-ink-muted);
  }
  .mcard__efeito :global(svg) {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 2px;
    color: var(--c-blue);
  }
  .mcard__acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
    margin-top: auto;
    padding-top: 8px;
  }
  .mcard__acoes .btn :global(svg) {
    width: 16px;
  }
  .mcard__demo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 15px;
    color: var(--c-blue);
    text-decoration: none;
  }
  .mcard__demo :global(svg) {
    width: 15px;
    height: 15px;
  }
  .mcard__soon {
    font-size: 14px;
    color: var(--c-ink-muted);
  }
  @media (max-width: 1000px) {
    .mg__grid {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const ativar = (tab: HTMLButtonElement, foco = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        box.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!.hidden = !on;
      }
      if (foco) tab.focus();
      tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => ativar(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        ativar(tabs[(i + d + tabs.length) % tabs.length], true);
      });
    });
  });
</script>
