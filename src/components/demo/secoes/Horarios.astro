---
import type { Demo } from '../../../data/demos/tipos';
const { demo } = Astro.props as { demo: Demo };
const h = demo.horarios!;
const chaves = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sab'];
const chave = (d: string) => chaves.find((c) => d.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').startsWith(c)) ?? d;
---
<section class="d-sec d-hor" id="horarios">
  <div class="d-wrap">
    <div class="d-head">
      {h.eyebrow && <p class="d-eyebrow" data-r>{h.eyebrow}</p>}
      <h2 class="d-h2" data-r>{h.titulo}</h2>
      {h.intro && <p class="d-lead" data-r>{h.intro}</p>}
    </div>
    <div class="d-hor__scroll" data-r data-hor>
      <table>
        <thead><tr><th>Horário</th>{h.dias.map((d) => <th data-dia={chave(d)}>{d}</th>)}</tr></thead>
        <tbody>
          {h.linhas.map((l) => (
            <tr>
              <th scope="row">{l.hora}</th>
              {l.aulas.map((a, i) => <td data-dia={chave(h.dias[i])} class={a ? '' : 'is-vazio'}>{a ? <span>{a}</span> : '—'}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {h.nota && <p class="d-hor__nota">{h.nota}</p>}
  </div>
</section>
