---
import type { Demo } from '../../../data/demos/tipos';
const { demo } = Astro.props as { demo: Demo };
const w = demo.wod!;
---
<section class="d-sec d-wod" id="wod">
  <div class="d-wrap">
    <div class="d-wod__board" data-r>
      <div class="d-wod__top">
        <p class="d-eyebrow">Treino do dia · {w.data}</p>
        <h2 class="d-h2">{w.titulo}</h2>
        <p class="d-wod__fmt"><span>{w.formato}</span><span>{w.tempo}</span></p>
      </div>
      <div class="d-wod__blocos">
        {w.blocos.map((b) => (
          <div class="d-wod__bloco">
            <p class="d-wod__nome">{b.nome}</p>
            <ul>{b.linhas.map((l) => <li data-chalk>{l}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="d-wod__pe">Escalas para iniciantes em todas as aulas. Pergunte ao coach.</p>
    </div>
  </div>
</section>
<style is:global>
  .d-wod__board {
    position: relative;
    padding: clamp(26px, 4vw, 56px);
    border-radius: var(--d-r);
    background:
      radial-gradient(120% 80% at 20% 0%, rgb(255 255 255 / 6%), transparent 60%),
      repeating-linear-gradient(-8deg, rgb(255 255 255 / 1.5%) 0 2px, transparent 2px 9px),
      #1d2321;
    color: #f2f2ee;
    box-shadow: inset 0 0 0 10px #2b2b2b, inset 0 0 0 12px #3b3b3b, var(--d-shadow);
  }
  .d-wod__top {
    display: grid;
    gap: 10px;
    padding-bottom: 22px;
    border-bottom: 2px dashed rgb(255 255 255 / 22%);
  }
  .d-wod__fmt {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .d-wod__fmt span {
    padding: 6px 12px;
    border: 2px solid var(--d-accent);
    color: var(--d-accent);
    font: 700 15px/1 var(--d-display);
    text-transform: uppercase;
  }
  .d-wod__blocos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 28px;
    margin-top: 26px;
  }
  .d-wod__nome {
    margin-bottom: 12px;
    font: 700 14px/1 var(--d-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--d-accent);
  }
  .d-wod__bloco li {
    min-height: 1.5em;
    font: 500 clamp(17px, 1.4vw, 20px) / 1.5 var(--d-display);
  }
  .d-wod__pe {
    margin-top: 28px;
    font-size: 14px;
    opacity: 0.6;
  }
</style>
