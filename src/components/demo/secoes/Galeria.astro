---
import { Image } from 'astro:assets';
import type { Demo } from '../../../data/demos/tipos';
const { demo } = Astro.props as { demo: Demo };
const g = demo.galeria!;
---
<section class="d-sec d-gal" id="galeria">
  <div class="d-wrap">
    <div class="d-head">
      {g.eyebrow && <p class="d-eyebrow" data-r>{g.eyebrow}</p>}
      <h2 class="d-h2" data-r>{g.titulo}</h2>
      {g.intro && <p class="d-lead" data-r>{g.intro}</p>}
    </div>
    <div class="d-gal__grid">
      {g.fotos.map((x) => (
        <figure class="d-gal__item" data-r data-curtain>
          <Image src={x.foto} alt={x.legenda ?? ''} widths={[400, 800, 1200]} sizes="(min-width: 900px) 600px, 92vw" />
          {x.legenda && <figcaption>{x.legenda}</figcaption>}
        </figure>
      ))}
    </div>
  </div>
</section>
