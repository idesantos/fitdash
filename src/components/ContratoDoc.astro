---
// O contrato como documento. Campos {{x}} viram <span data-c="x">, que o formulário preenche
// com os dados do pedido. Sem pedido (página /termos/), mostram o rótulo em branco.
import { marca } from '../data/oferta';
import {
  tituloContrato,
  versaoContrato,
  qualificacaoContratada,
  qualificacaoContratante,
  preambulo,
  clausulas,
  encerramento,
  nomeClausula,
  camposEmBranco,
} from '../data/contrato';

type Props = { id?: string };
const { id } = Astro.props;
const partes = (txt: string) => txt.split(/(\{\{\w+\}\})/g).filter(Boolean).map((p) => {
  const m = p.match(/^\{\{(\w+)\}\}$/);
  return m ? { campo: m[1] } : { texto: p };
});
---
<article class="cdoc" id={id} data-contrato>
  <header class="cdoc__topo">
    <p class="cdoc__marca">{marca.nome}</p>
    <p class="cdoc__versao">Versão {versaoContrato}</p>
  </header>
  <h1 class="cdoc__titulo">{tituloContrato}</h1>

  <section class="cdoc__partes">
    <p><strong>CONTRATADA:</strong> {qualificacaoContratada}</p>
    <p><strong>CONTRATANTE:</strong> {partes(qualificacaoContratante).map((p) => ('campo' in p ? <span class="cdoc__campo" data-c={p.campo}>{camposEmBranco[p.campo!]}</span> : p.texto))}</p>
  </section>
  <p class="cdoc__pre">{preambulo}</p>

  {clausulas.map((c, i) => (
    <section class="cdoc__clausula">
      <h2>{nomeClausula(i)} · {c.titulo}</h2>
      {c.itens.map((t, j) => (
        <p>
          <span class="cdoc__num">{i + 1}.{j + 1}.</span>{' '}
          {partes(t).map((p) => ('campo' in p ? <span class="cdoc__campo" data-c={p.campo}>{camposEmBranco[p.campo!]}</span> : p.texto))}
        </p>
      ))}
    </section>
  ))}

  <p class="cdoc__fim">{encerramento}</p>
  <p class="cdoc__data"><span class="cdoc__campo" data-c="localData">{camposEmBranco.localData}</span></p>

  <div class="cdoc__assinaturas">
    <div>
      <p class="cdoc__linha">{marca.razaoSocial}</p>
      <p>CONTRATADA · CNPJ {marca.cnpj}</p>
    </div>
    <div>
      <p class="cdoc__linha"><span class="cdoc__campo" data-c="assinante">{camposEmBranco.assinante}</span></p>
      <p>CONTRATANTE · <span class="cdoc__campo" data-c="documento">{camposEmBranco.documento}</span></p>
    </div>
  </div>
  <p class="cdoc__registro">Aceite eletrônico: <span class="cdoc__campo" data-c="aceite">{camposEmBranco.aceite}</span></p>
</article>

<style is:global>
  .cdoc {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 64px) clamp(22px, 5vw, 70px);
    background: #fff;
    color: #1b1b1b;
    font: 400 15.5px/1.7 Georgia, 'Times New Roman', serif;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 6%),
      0 24px 60px -36px rgb(0 0 0 / 40%);
  }
  .cdoc__topo {
    display: flex;
    justify-content: space-between;
    padding-bottom: 14px;
    margin-bottom: 26px;
    border-bottom: 1px solid #1b1b1b;
    font: 700 11px/1 'Inter Variable', system-ui, sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .cdoc__marca {
    font-style: italic;
  }
  .cdoc__versao {
    color: #666;
  }
  .cdoc__titulo {
    margin: 0 0 28px;
    font: 700 19px/1.35 Georgia, 'Times New Roman', serif;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
  }
  .cdoc p {
    margin: 0 0 10px;
    text-align: justify;
    hyphens: auto;
  }
  .cdoc__partes p {
    margin-bottom: 12px;
  }
  .cdoc__pre {
    margin-top: 18px !important;
  }
  .cdoc__clausula h2 {
    margin: 26px 0 10px;
    font: 700 14px/1.4 Georgia, 'Times New Roman', serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .cdoc__num {
    font-weight: 700;
  }
  .cdoc__campo {
    padding: 0 3px;
    border-radius: 3px;
    background: #fff4d6;
    color: #6b4b00;
  }
  .cdoc__campo.is-ok {
    padding: 0;
    background: transparent;
    color: inherit;
    font-weight: 700;
  }
  .cdoc__fim {
    margin-top: 30px !important;
  }
  .cdoc__data {
    text-align: right !important;
  }
  .cdoc__assinaturas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 56px;
    text-align: center;
  }
  .cdoc__assinaturas p {
    text-align: center;
    font-size: 13px;
    margin: 0;
  }
  .cdoc__linha {
    padding-top: 10px;
    border-top: 1px solid #1b1b1b;
    font-size: 15px !important;
    font-weight: 700;
  }
  .cdoc__registro {
    margin-top: 34px !important;
    padding: 12px 14px;
    border: 1px dashed #999;
    font: 500 12.5px/1.5 'Inter Variable', system-ui, sans-serif;
    color: #444;
    text-align: left !important;
  }
  @media (max-width: 600px) {
    .cdoc {
      font-size: 14.5px;
    }
    .cdoc p {
      text-align: left;
    }
    .cdoc__assinaturas {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }

  /* Via para imprimir ou salvar em PDF */
  #via-contrato {
    display: none;
  }
  @media print {
    @page {
      margin: 18mm 16mm;
    }
    html.imprimindo-via body > *:not(#via-contrato) {
      display: none !important;
    }
    html.imprimindo-via #via-contrato {
      display: block !important;
    }
    html.imprimindo-via,
    html.imprimindo-via body {
      background: #fff !important;
    }
    #via-contrato .cdoc {
      max-width: none;
      padding: 0;
      box-shadow: none;
      font-size: 11.5pt;
    }
    #via-contrato .cdoc__campo {
      padding: 0;
      background: transparent;
      color: inherit;
    }
    .cdoc__clausula {
      break-inside: avoid-page;
    }
    .cdoc__assinaturas {
      break-inside: avoid;
    }
  }
</style>
